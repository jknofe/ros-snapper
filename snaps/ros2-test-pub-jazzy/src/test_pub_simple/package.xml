<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>test_pub_simple</name>
  <version>0.1.0</version>
  <description>Minimal Python publisher for std_msgs and geometry_msgs on the test/* topics. Part of the ros-snapper bundled pub/sub example.</description>
  <maintainer email="dev@example.com">ros-snapper</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
